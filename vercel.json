{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "eunomi.cl"
        }
      ],
      "destination": "/eunomi-escolar/"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.eunomi.cl"
        }
      ],
      "destination": "/eunomi-escolar/"
    }
  ]
}
