{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/:path((?!eunomi-escolar/).*)",
      "has": [
        {
          "type": "host",
          "value": "eunomi.cl"
        }
      ],
      "destination": "/eunomi-escolar/:path*"
    },
    {
      "source": "/:path((?!eunomi-escolar/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.eunomi.cl"
        }
      ],
      "destination": "/eunomi-escolar/:path*"
    }
  ]
}
